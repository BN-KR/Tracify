SCHEMA >
    `scoreId` String `json:$.scoreId`,
    `projectId` String `json:$.projectId`,
    `traceId` String `json:$.traceId` DEFAULT '',
    `evaluatorId` String `json:$.evaluatorId`,
    `scoreName` String `json:$.scoreName`,
    `dataType` String `json:$.dataType`,
    `valueNumeric` Float64 `json:$.valueNumeric` DEFAULT 0,
    `valueBoolean` Bool `json:$.valueBoolean` DEFAULT 0,
    `valueCategorical` String `json:$.valueCategorical` DEFAULT '',
    `status` String `json:$.status`,
    `modelId` String `json:$.modelId` DEFAULT '',
    `environment` String `json:$.environment` DEFAULT '',
    `createdAt` DateTime `json:$.createdAt`

ENGINE MergeTree
ENGINE_PARTITION_KEY toYYYYMM(createdAt)
ENGINE_PRIMARY_KEY projectId, scoreName
ENGINE_SORTING_KEY projectId, scoreName, createdAt, scoreId
ENGINE_TTL createdAt + toIntervalDay(365)
