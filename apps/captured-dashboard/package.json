    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "@playwright/test": "1.51.1",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
